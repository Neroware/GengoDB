PREFIX bsbm-inst: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>

SELECT DISTINCT ?product ?productLabel
WHERE {
  ?product rdfs:label ?productLabel .

  FILTER (bsbm-inst:Product4711 != ?product)

  bsbm-inst:Product4711 bsbm:productFeature ?prodFeature .
  ?product bsbm:productFeature ?prodFeature .

  bsbm-inst:Product4711 bsbm:productPropertyNumeric1 ?origProperty1 .
  ?product bsbm:productPropertyNumeric1 ?simProperty1 .
  FILTER (
    ?simProperty1 < (?origProperty1 + 120) &&
    ?simProperty1 > (?origProperty1 - 120)
  )

  bsbm-inst:Product4711 bsbm:productPropertyNumeric2 ?origProperty2 .
  ?product bsbm:productPropertyNumeric2 ?simProperty2 .
  FILTER (
    ?simProperty2 < (?origProperty2 + 170) &&
    ?simProperty2 > (?origProperty2 - 170)
  )
}
ORDER BY ?productLabel
LIMIT 5