PREFIX ex: <http://example.org/>

SELECT ?person ?food ?cup ?drink
WHERE {
    GRAPH <file://resources/ttl/coffee/coffee.ttl#rdf> {
        {
            ?person ex:eats ?food .
            OPTIONAL { ?person ex:cup ?cup . }
        }
        {
            ?person ex:drinks ?drink .
            OPTIONAL { ?person ex:cup ?cup . }
        }
    }
}
