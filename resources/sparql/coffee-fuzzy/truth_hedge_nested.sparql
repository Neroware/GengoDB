# Hedges only transform the degree bound by their own TRUTH block: ?outer is the hedged product of all
# triples (raw inner degrees included), ?inner is NOT of the inner block alone.
# Expected: e.g. bob/coffee inner 1 - 0.9 = 0.1, outer (0.95*0.9)^2 = 0.731
PREFIX ex: <http://example.org/>
SELECT ?p ?d ?inner ?outer
{
    GRAPH <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf> {
        TRUTH ?outer OF VERY {
            ?p ex:type ex:Person .
            TRUTH ?inner OF NOT { ?p ex:drinks ?d . }
        }
    }
}
