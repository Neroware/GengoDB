# A nested TRUTH block enters the enclosing block's t-norm with its *hedged* degree: ?inner is NOT of the inner
# block, ?outer is VERY of (Person degree * ?inner).
# Expected: e.g. bob/coffee inner 1 - 0.9 = 0.1, outer (0.95*0.1)^2 = 0.009025; bob/miso inner 1.0, outer 0.9025
PREFIX ex: <http://example.org/>
SELECT ?p ?d ?inner ?outer
{
    GRAPH <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf> {
        TRUTH ?outer OF VERY {
            ?p ex:type ex:Person .
            TRUTH ?inner OF NOT { ?p ex:drinks ?d . }
        }
    }
}
