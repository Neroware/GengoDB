# A builtin hedge given by its full IRI instead of the keyword. Same result as truth_hedge_very.sparql.
PREFIX ex: <http://example.org/>
SELECT ?p ?t
{
    GRAPH <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf> {
        TRUTH ?t OF <https://www.forsocialrobots.de/ontologies/fuzzy-rdf-syntax-ns.rdf#VERY> { ?p ex:drinks ex:coffee . }
    }
}
