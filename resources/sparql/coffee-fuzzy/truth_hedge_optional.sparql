# Hedge over an OPTIONAL-only block: a person without any drink has degree 1.0 (nothing matched, the t-norm's
# neutral element), so NOT gives ?truth = 0.0. Same rows as truth_optional.sparql; all truths become 1 - x.
PREFIX ex: <http://example.org/>
SELECT ?person ?drink ?truth
{
    GRAPH <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf> {
        ?person ex:type ex:Person .
        TRUTH ?truth OF NOT {
            OPTIONAL { ?person ex:drinks ?drink . }
        }
    }
}
