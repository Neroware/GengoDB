LOAD <file://resources/ttl/coffee-fuzzy/coffee.fttl> INTO GRAPH <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf>;
LOAD <file://resources/ttl/coffee-fuzzy/coffee.fttl> INTO GRAPH <gengodb://sparql/settings/defaultGraph#rdf>;

PREFIX db: <gengodb://sparql/settings/>
DESCRIBE ?entity WHERE {
    ?entity db:persists true .
    ?entity db:defaultGraph <file://resources/ttl/coffee-fuzzy/coffee.fttl#rdf> .
    ?entity db:initialize true . 
};